datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// System initialization anchor model
model SystemHealthAnchor {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DriverAvailability {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  EXPERT
}

enum VehicleStatus {
  AVAILABLE
  ON_TRIP
  MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum VehicleType {
  TRUCK
  VAN
  TRAILER
  BUS
  CAR
  SPECIALIZED
}

enum FuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum ShipmentPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ShipmentStatus {
  PENDING
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

enum RouteType {
  HIGHWAY
  URBAN
  INTERSTATE
  CROSS_BORDER
  REGIONAL
  LAST_MILE
}

enum RouteStatus {
  PLANNED
  ACTIVE
  OPTIMIZED
  COMPLETED
  CANCELLED
}

enum TripStatus {
  SCHEDULED
  DISPATCHED
  IN_TRANSIT
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

model Company {
  id                 String        @id @default(uuid())
  name               String
  legalName          String?
  registrationNumber String?       @unique
  taxNumber          String?
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  logoUrl            String?
  website            String?
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users     User[]
  drivers   Driver[]
  vehicles  Vehicle[]
  customers Customer[]
  shipments Shipment[]
  routes    Route[]
  trips     Trip[]

  @@index([name])
  @@index([registrationNumber])
  @@index([status])
  @@index([createdAt])
}

/// Represents system and custom Role-Based Access Control (RBAC) roles
model Role {
  /// Primary key UUID
  id          String   @id @default(uuid())
  /// Unique role name (e.g. Super Admin, Fleet Manager, Driver)
  name        String   @unique
  /// Description of permissions granted by this role
  description String?
  /// JSON structure defining granular RBAC permission policies
  permissions Json
  /// Flag indicating system-defined role that cannot be deleted
  isSystem    Boolean  @default(false)
  /// Creation timestamp
  createdAt   DateTime @default(now())
  /// Last modification timestamp
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isSystem])
  @@index([createdAt])
}

/// --------------------------------------------
/// User
/// Represents an application user.
/// Users belong to a Company
/// and are assigned a Role.
/// --------------------------------------------
model User {
  /// Primary key UUID
  id            String     @id @default(uuid())
  /// First name of user
  firstName     String
  /// Last name of user
  lastName      String
  /// Unique contact & login email address
  email         String     @unique
  /// Contact phone number
  phone         String?
  /// Encrypted password hash storage
  passwordHash  String
  /// Foreign key referencing parent Company
  companyId     String
  /// Foreign key referencing assigned Role
  roleId        String
  /// Organization department (e.g. Logistics, Fleet Operations)
  department    String?
  /// Job title or designation
  designation   String?
  /// Profile avatar URL
  avatarUrl     String?
  /// Account operational status
  status        UserStatus @default(ACTIVE)
  /// Email verification flag
  emailVerified Boolean    @default(false)
  /// Last login timestamp
  lastLogin     DateTime?
  /// Creation timestamp
  createdAt     DateTime   @default(now())
  /// Last modification timestamp
  updatedAt     DateTime   @updatedAt

  /// Parent Company relation
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Assigned Role relation
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Optional Driver profile extension
  driverProfile Driver?

  @@index([companyId])
  @@index([roleId])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([lastLogin])
}

/// --------------------------------------------
/// Driver
/// Represents an operational driver profile.
/// Extends a User account and belongs to a Company.
/// --------------------------------------------
model Driver {
  /// Primary key UUID
  id                    String             @id @default(uuid())
  /// Unique company employee identification code
  employeeId            String             @unique
  /// Driving experience level classification
  experienceLevel       ExperienceLevel    @default(MID)
  /// Current operational duty availability status
  availability          DriverAvailability @default(AVAILABLE)
  /// Commercial driver license number
  licenseNumber         String             @unique
  /// License expiration date
  licenseExpiry         DateTime
  /// Employment start date
  joiningDate           DateTime?
  /// Emergency contact person name
  emergencyContactName  String?
  /// Emergency contact person phone number
  emergencyContactPhone String?
  /// Foreign key referencing associated User account
  userId                String             @unique
  /// Foreign key referencing parent Company
  companyId             String
  /// Creation timestamp
  createdAt             DateTime           @default(now())
  /// Last modification timestamp
  updatedAt             DateTime           @updatedAt

  /// Associated User account relation
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Parent Company relation
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@index([companyId])
  @@index([availability])
  @@index([experienceLevel])
  @@index([licenseExpiry])
  @@index([createdAt])
}

/// --------------------------------------------
/// Vehicle
/// Represents a physical fleet asset.
/// Belongs to a Company.
/// Driver assignment is handled dynamically via Trip.
/// --------------------------------------------
model Vehicle {
  /// Primary key UUID
  id                 String        @id @default(uuid())
  /// Official vehicle license plate registration number
  registrationNumber String        @unique
  /// Unique Vehicle Identification Number (VIN)
  vin                String        @unique
  /// Vehicle manufacturer make (e.g., Volvo, Scania, Ford)
  make               String
  /// Vehicle model name or series
  model              String
  /// Vehicle manufacturing year
  manufacturingYear  Int
  /// Vehicle classification category
  vehicleType        VehicleType   @default(TRUCK)
  /// Fuel or energy source type
  fuelType           FuelType      @default(DIESEL)
  /// Cargo or passenger payload capacity (e.g. in kg or cubic meters)
  capacity           Float?
  /// Current operational asset status
  status             VehicleStatus @default(AVAILABLE)
  /// Foreign key referencing parent Company
  companyId          String
  /// Creation timestamp
  createdAt          DateTime      @default(now())
  /// Last modification timestamp
  updatedAt          DateTime      @updatedAt

  /// Parent Company relation
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips   Trip[]

  @@index([companyId])
  @@index([vehicleType])
  @@index([fuelType])
  @@index([status])
  @@index([manufacturingYear])
  @@index([createdAt])
}

/// --------------------------------------------
/// Customer
/// Represents a business or individual client.
/// Customers request shipments and belong to a Company.
/// --------------------------------------------
model Customer {
  /// Primary key UUID
  id            String         @id @default(uuid())
  /// Unique customer reference code
  customerCode  String         @unique
  /// Registered company or business name
  companyName   String
  /// Primary contact person name
  contactPerson String?
  /// Primary contact email address
  email         String
  /// Contact phone number
  phone         String?
  /// Physical street address
  address       String?
  /// City location
  city          String?
  /// State / Province
  state         String?
  /// Country location
  country       String?
  /// Postal / ZIP code
  postalCode    String?
  /// Account status
  status        CustomerStatus @default(ACTIVE)
  /// Foreign key referencing parent Company
  companyId     String
  /// Creation timestamp
  createdAt     DateTime       @default(now())
  /// Last modification timestamp
  updatedAt     DateTime       @updatedAt

  /// Parent Company relation
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@index([companyId])
  @@index([customerCode])
  @@index([companyName])
  @@index([status])
  @@index([createdAt])
}

/// --------------------------------------------
/// Shipment
/// Represents a business request to transport goods.
/// Belongs to a Customer and a Company.
/// Vehicle and driver assignment is handled dynamically via Trip.
/// --------------------------------------------
model Shipment {
  /// Primary key UUID
  id                   String           @id @default(uuid())
  /// Unique shipment tracking reference number
  shipmentNumber       String           @unique
  /// Short title or name of the shipment request
  title                String
  /// Detailed description of cargo contents or instructions
  description          String?
  /// Type or category of cargo (e.g. Perishable, Electronics, Bulk)
  cargoType            String?
  /// Total weight of cargo (e.g. in kg)
  weight               Float?
  /// Total volume of cargo (e.g. in cubic meters)
  volume               Float?
  /// Quantity of items or packages
  quantity             Int?
  /// Origin pickup street address
  pickupAddress        String
  /// Origin pickup city
  pickupCity           String
  /// Origin pickup state / province
  pickupState          String?
  /// Origin pickup country
  pickupCountry        String
  /// Origin pickup postal / ZIP code
  pickupPostalCode     String?
  /// Scheduled or actual pickup date
  pickupDate           DateTime?
  /// Destination delivery street address
  deliveryAddress      String
  /// Destination delivery city
  deliveryCity         String
  /// Destination delivery state / province
  deliveryState        String?
  /// Destination delivery country
  deliveryCountry      String
  /// Destination delivery postal / ZIP code
  deliveryPostalCode   String?
  /// Expected or scheduled delivery date
  expectedDeliveryDate DateTime?
  /// Dispatch urgency priority level
  priority             ShipmentPriority @default(MEDIUM)
  /// Lifecycle status of the shipment request
  status               ShipmentStatus   @default(PENDING)
  /// Foreign key referencing requesting Customer
  customerId           String
  /// Foreign key referencing parent Company
  companyId            String
  /// Creation timestamp
  createdAt            DateTime         @default(now())
  /// Last modification timestamp
  updatedAt            DateTime         @updatedAt

  /// Requesting Customer relation
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Parent Company relation
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  routes   Route[]
  trips    Trip[]

  @@index([companyId])
  @@index([customerId])
  @@index([shipmentNumber])
  @@index([status])
  @@index([priority])
  @@index([pickupDate])
  @@index([expectedDeliveryDate])
  @@index([createdAt])
}

/// --------------------------------------------
/// Route
/// Represents the planned transportation path for a Shipment.
/// Route contains planning metrics only.
/// Belongs to a Shipment and a Company.
/// Vehicle and driver assignment occurs through Trip.
/// --------------------------------------------
model Route {
  /// Primary key UUID
  id                 String      @id @default(uuid())
  /// Unique route identification code
  routeCode          String      @unique
  /// Planned origin pickup street address
  originAddress      String
  /// Planned origin city
  originCity         String
  /// Planned origin state / province
  originState        String?
  /// Planned origin country
  originCountry      String
  /// Planned destination delivery street address
  destinationAddress String
  /// Planned destination city
  destinationCity    String
  /// Planned destination state / province
  destinationState   String?
  /// Planned destination country
  destinationCountry String
  /// Total planned distance (e.g. in km)
  plannedDistance    Float?
  /// Total estimated duration (e.g. in minutes or hours)
  estimatedDuration  Float?
  /// Route classification category
  routeType          RouteType   @default(HIGHWAY)
  /// Planning status of the route
  status             RouteStatus @default(PLANNED)
  /// Foreign key referencing parent Shipment
  shipmentId         String
  /// Foreign key referencing parent Company
  companyId          String
  /// Creation timestamp
  createdAt          DateTime    @default(now())
  /// Last modification timestamp
  updatedAt          DateTime    @updatedAt

  /// Parent Shipment relation
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// Parent Company relation
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trips    Trip[]

  @@index([companyId])
  @@index([shipmentId])
  @@index([status])
  @@index([routeType])
  @@index([createdAt])
}

/// --------------------------------------------
/// Trip
/// Represents the operational execution of a planned Shipment.
/// Links Driver, Vehicle, Shipment, Route, and Company.
/// Route represents what was planned; Trip represents what actually occurred.
/// --------------------------------------------
model Trip {
  /// Primary key UUID
  id                 String     @id @default(uuid())
  /// Unique operational trip identification number
  tripNumber         String     @unique
  /// Planned or scheduled trip start timestamp
  scheduledStartTime DateTime?
  /// Actual timestamp when trip dispatch started
  actualStartTime    DateTime?
  /// Planned or scheduled trip completion timestamp
  scheduledEndTime   DateTime?
  /// Actual timestamp when trip was completed
  actualEndTime      DateTime?
  /// Operational execution status of the trip
  status             TripStatus @default(SCHEDULED)
  /// Actual distance traveled during trip execution (e.g. in km)
  actualDistance     Float?
  /// Actual duration of trip execution (e.g. in minutes or hours)
  actualDuration     Float?
  /// Operational notes, remarks, or incident reports
  remarks            String?
  /// Foreign key referencing parent Company
  companyId          String
  /// Foreign key referencing assigned Driver
  driverId           String
  /// Foreign key referencing assigned Vehicle asset
  vehicleId          String
  /// Foreign key referencing executed Shipment request
  shipmentId         String
  /// Foreign key referencing planned Route
  routeId            String
  /// Creation timestamp
  createdAt          DateTime   @default(now())
  /// Last modification timestamp
  updatedAt          DateTime   @updatedAt

  /// Parent Company relation
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Assigned Driver relation
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  /// Assigned Vehicle relation
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// Executed Shipment relation
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  /// Planned Route relation
  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([shipmentId])
  @@index([routeId])
  @@index([status])
  @@index([scheduledStartTime])
  @@index([actualStartTime])
  @@index([createdAt])
}
