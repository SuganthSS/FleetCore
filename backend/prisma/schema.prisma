datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// System initialization anchor model
model SystemHealthAnchor {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum DriverAvailability {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
  ON_LEAVE
  SUSPENDED
}

enum ExperienceLevel {
  JUNIOR
  MID
  SENIOR
  EXPERT
}

model Company {
  id                 String        @id @default(uuid())
  name               String
  legalName          String?
  registrationNumber String?       @unique
  taxNumber          String?
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  country            String?
  postalCode         String?
  logoUrl            String?
  website            String?
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  users   User[]
  drivers Driver[]

  @@index([name])
  @@index([registrationNumber])
  @@index([status])
  @@index([createdAt])
}

/// Represents system and custom Role-Based Access Control (RBAC) roles
model Role {
  /// Primary key UUID
  id          String   @id @default(uuid())
  /// Unique role name (e.g. Super Admin, Fleet Manager, Driver)
  name        String   @unique
  /// Description of permissions granted by this role
  description String?
  /// JSON structure defining granular RBAC permission policies
  permissions Json
  /// Flag indicating system-defined role that cannot be deleted
  isSystem    Boolean  @default(false)
  /// Creation timestamp
  createdAt   DateTime @default(now())
  /// Last modification timestamp
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([isSystem])
  @@index([createdAt])
}

/// --------------------------------------------
/// User
/// Represents an application user.
/// Users belong to a Company
/// and are assigned a Role.
/// --------------------------------------------
model User {
  /// Primary key UUID
  id            String     @id @default(uuid())
  /// First name of user
  firstName     String
  /// Last name of user
  lastName      String
  /// Unique contact & login email address
  email         String     @unique
  /// Contact phone number
  phone         String?
  /// Encrypted password hash storage
  passwordHash  String
  /// Foreign key referencing parent Company
  companyId     String
  /// Foreign key referencing assigned Role
  roleId        String
  /// Organization department (e.g. Logistics, Fleet Operations)
  department    String?
  /// Job title or designation
  designation   String?
  /// Profile avatar URL
  avatarUrl     String?
  /// Account operational status
  status        UserStatus @default(ACTIVE)
  /// Email verification flag
  emailVerified Boolean    @default(false)
  /// Last login timestamp
  lastLogin     DateTime?
  /// Creation timestamp
  createdAt     DateTime   @default(now())
  /// Last modification timestamp
  updatedAt     DateTime   @updatedAt

  /// Parent Company relation
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Assigned Role relation
  role          Role    @relation(fields: [roleId], references: [id], onDelete: Restrict)
  /// Optional Driver profile extension
  driverProfile Driver?

  @@index([companyId])
  @@index([roleId])
  @@index([status])
  @@index([department])
  @@index([createdAt])
  @@index([lastLogin])
}

/// --------------------------------------------
/// Driver
/// Represents an operational driver profile.
/// Extends a User account and belongs to a Company.
/// --------------------------------------------
model Driver {
  /// Primary key UUID
  id                    String             @id @default(uuid())
  /// Unique company employee identification code
  employeeId            String             @unique
  /// Driving experience level classification
  experienceLevel       ExperienceLevel    @default(MID)
  /// Current operational duty availability status
  availability          DriverAvailability @default(AVAILABLE)
  /// Commercial driver license number
  licenseNumber         String             @unique
  /// License expiration date
  licenseExpiry         DateTime
  /// Employment start date
  joiningDate           DateTime?
  /// Emergency contact person name
  emergencyContactName  String?
  /// Emergency contact person phone number
  emergencyContactPhone String?
  /// Foreign key referencing associated User account
  userId                String             @unique
  /// Foreign key referencing parent Company
  companyId             String
  /// Creation timestamp
  createdAt             DateTime           @default(now())
  /// Last modification timestamp
  updatedAt             DateTime           @updatedAt

  /// Associated User account relation
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Parent Company relation
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([availability])
  @@index([experienceLevel])
  @@index([licenseExpiry])
  @@index([createdAt])
}
